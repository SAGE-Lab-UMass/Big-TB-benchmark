# Copy this file to .evo2-site.env and replace the example values.
# .evo2-site.env is ignored by Git.

# Runtime executables and optional site module.
EVO2_EMBED_PYTHON=/path/to/evo2-environment/bin/python
EVO2_TRAIN_PYTHON=/path/to/training-environment/bin/python
EVO2_CUDA_MODULE=

# Embedding inputs and generated outputs.
EVO2_GENOTYPE_INPUT_DIRECTORY=/path/to/aligned-fasta-directory
EVO2_PHENOTYPE_FILE=/path/to/master_resistance_table.csv
EVO2_DATA_DIR="${EVO2_DIR}/data/multidrug_classification/training"
EVO2_EMBED_ROOT=/path/to/evo2/embeddings/zero-shot/token/layer20/full

# Prepared inputs used by random-split and lineage-aware downstream training.
EVO2_DOWNSTREAM_DATA_ROOT=/path/to/evo2/downstream_inputs/layer20
EVO2_GENO_PHENO_CSV="${EVO2_DATA_DIR}/geno_pheno_full_combined.csv"
EVO2_LINEAGE_CSV=/path/to/BIG_TB_isolates_with_lineages.csv

# Slurm site settings. Leave optional values empty when the cluster has defaults.
EVO2_SLURM_ACCOUNT=
EVO2_SLURM_PARTITION=
EVO2_SLURM_CPU_PARTITION=
EVO2_SLURM_MAIL_USER=
EVO2_SLURM_MAIL_TYPE=END,FAIL
EVO2_EMBED_ARRAY_CONCURRENCY=3
